{
  "name": "get_bitrix_warehouses",
  "description": "Получение списка всех складов из Битрикс24 с возможностью фильтрации по названию",
  "inputSchema": {
    "type": "object",
    "properties": {
      "filter_title": {
        "type": "string",
        "description": "Фильтр по названию склада (частичное совпадение)"
      },
      "active_only": {
        "type": "boolean",
        "description": "Только активные склады"
      },
      "limit": {
        "type": "integer",
        "description": "Максимальное количество складов"
      }
    }
  }
},
{
  "name": "get_bitrix_product_stock",
  "description": "Получение остатков конкретного товара на всех или определенном складе Битрикс24",
  "inputSchema": {
    "type": "object",
    "properties": {
      "product_sku": {
        "type": "string",
        "description": "SKU товара"
      },
      "warehouse_id": {
        "type": "integer",
        "description": "ID конкретного склада (опционально)"
      }
    },
    "required": ["product_sku"]
  }
},
{
  "name": "set_bitrix_product_stock",
  "description": "Установка или обновление остатков товара на конкретном складе в Битрикс24",
  "inputSchema": {
    "type": "object",
    "properties": {
      "product_sku": {
        "type": "string",
        "description": "SKU товара"
      },
      "warehouse_id": {
        "type": "integer",
        "description": "ID склада"
      },
      "quantity": {
        "type": "number",
        "description": "Количество (может быть дробным для весовых товаров)"
      },
      "reserve_quantity": {
        "type": "number",
        "description": "Зарезервированное количество"
      }
    },
    "required": ["product_sku", "warehouse_id", "quantity"]
  }
},
{
  "name": "create_bitrix_warehouse",
  "description": "Создание нового склада в Битрикс24 с указанием названия, адреса и описания",
  "inputSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "Название склада"
      },
      "address": {
        "type": "string",
        "description": "Адрес склада"
      },
      "description": {
        "type": "string",
        "description": "Описание склада"
      },
      "active": {
        "type": "string",
        "enum": ["Y", "N"],
        "description": "Активность склада"
      }
    },
    "required": ["title"]
  }
},
{
  "name": "sync_all_stock_to_bitrix",
  "description": "Полная синхронизация всех остатков товаров из MCP системы в склад Битрикс24",
  "inputSchema": {
    "type": "object",
    "properties": {},
    "required": []
  }
}