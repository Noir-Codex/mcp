# Вставте API от модели в EVOLUTION_API_KEY
EVOLUTION_API_KEY=
EVOLUTION_API_URL=https://foundation-models.api.cloud.ru/v1
EVOLUTION_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# MCP Server Configuration
MCP_SERVER_PORT=8000
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_URL=http://localhost:8000

# Warehouse API Configuration (если используется внешний API)
# Можно использовать реальный внешний API склада
# Или оставить пустым для использования локального хранилища (SQLite)
WAREHOUSE_API_URL=
WAREHOUSE_API_KEY=your_warehouse_api_key_here

# Logging
LOG_LEVEL=INFO

